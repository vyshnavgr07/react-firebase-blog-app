service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read, write: if true;  // Temporarily allow all access
    }
    match /blogs/{blogId} {
      allow read: if true;  // Allows anyone to read
      allow write: if request.auth != null;  // Allows authenticated users to write
    }
  }
}
